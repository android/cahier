# proto-file: third_party/ink/storage/proto/brush_family.proto
# proto-message: BrushFamily
client_brush_family_id: "valid_brush"
coats {
  tip {
    scale_x: 2.0
    scale_y: 1.0
    corner_rounding: 0.5
  }
  paint_preferences {
    self_overlap: SELF_OVERLAP_DISCARD
  }
}
